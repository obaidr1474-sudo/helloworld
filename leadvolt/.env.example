# Development only. Copy to server/.env for npm, or .env for Docker Compose.
DATABASE_URL=postgres://leadvolt_app:leadvolt_app@localhost:5432/leadvolt
WORKER_DATABASE_URL=postgres://leadvolt_worker:leadvolt_worker@localhost:5432/leadvolt
# Owner URI belongs only in the migration job, never in the production API service.
MIGRATION_DATABASE_URL=postgres://leadvolt:leadvolt@localhost:5432/leadvolt
JWT_SECRET=dev-only-change-me-dev-only-change-me
CORS_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173
PORT=4000
NODE_ENV=development
ALLOW_PUBLIC_REGISTRATION=true
# Production requires exact HTTPS origins, a random 32+ character JWT secret,
# strong role passwords, and ALLOW_PUBLIC_REGISTRATION=false. See docs/OPERATIONS.md.
TRUST_PROXY=
SESSION_HOURS=8
PG_POOL_MAX=20
WORKERS_ENABLED=true
SLA_INTERVAL_MS=30000

# Optional WhatsApp Business Cloud API. Production requires all six values.
# Bind this installation's number to one workspace; no shared cross-company token.
WA_WORKSPACE=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_API_VERSION=
