# Runtime connection: non-owner role so row-level security applies
DATABASE_URL=postgres://leadvolt_app:leadvolt_app@localhost:5432/leadvolt
# Owner connection used only by `npm run migrate`
MIGRATION_DATABASE_URL=postgres://leadvolt:leadvolt@localhost:5432/leadvolt
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:4000
PORT=4000

# WhatsApp Business Platform (Cloud API). Optional: without these, agents log messages they send from WhatsApp.
WA_VERIFY_TOKEN=
WA_APP_SECRET=
WA_ACCESS_TOKEN=
WA_PHONE_NUMBER_ID=

# Background workers (SLA monitor, task reminders)
WORKERS_ENABLED=true
SLA_INTERVAL_MS=30000
