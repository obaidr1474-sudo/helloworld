{
  "name": "@leadvolt/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "9.0.1",
    "@fastify/jwt": "8.0.1",
    "bcryptjs": "2.4.3",
    "dotenv": "16.4.5",
    "fastify": "4.28.1",
    "pg": "8.12.0",
    "socket.io": "4.7.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.14.12",
    "@types/pg": "8.11.6",
    "socket.io-client": "4.7.5",
    "tsx": "4.16.2",
    "typescript": "5.5.4",
    "vitest": "2.0.4"
  }
}
